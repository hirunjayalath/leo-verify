# Database (Supabase Postgres connection string)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Certificate HMAC signing (Rule 2 / §4) — never commit real values (Rule 9)
# Generate with: openssl rand -hex 32
CERT_HMAC_SECRET="replace-with-long-random-secret"
# Optional previous secret for zero-downtime rotation
CERT_HMAC_SECRET_PREVIOUS=""

# App URL (used in QR / verification links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible) — PDF & template image storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="leoverify"
R2_PUBLIC_URL=""

# Email (Resend recommended for low volume; SES for higher volume)
RESEND_API_KEY=""
EMAIL_FROM="LeoVerify <certificates@leoverify.org>"
