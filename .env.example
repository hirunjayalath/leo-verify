# Contract: docs/architecture.md
# * required in production  ·  empty OK locally  ·  never commit real secrets

# Postgres *
# DATABASE_URL: pooler as leoverify_app (RLS + withRlsContext)
# SERVICE_DATABASE_URL: pooler as leoverify_service (public verify / signup)
# DIRECT_DATABASE_URL: owner :5432 for migrate only
DATABASE_URL="postgresql://leoverify_app:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
SERVICE_DATABASE_URL="postgresql://leoverify_service:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
PG_POOL_MAX="3"

# Auth *
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# HMAC *
# openssl rand -hex 32
CERT_HMAC_SECRET="replace-with-long-random-secret"
CERT_HMAC_SECRET_PREVIOUS=""

# App *
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@leoverify.org"

# R2 *
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="leoverify"
R2_PUBLIC_URL=""

# Resend *
RESEND_API_KEY=""
EMAIL_FROM="LeoVerify <certificates@leoverify.org>"

# Inngest *
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
IMPORT_ROW_CONCURRENCY="5"

# Upstash *
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Seed
SEED_ADMIN_EMAIL="admin@uom.leoverify.local"
SEED_ADMIN_SUPABASE_ID="00000000-0000-4000-8000-000000000001"
SEED_ADMIN_NAME="UOM Club Admin"
# Optional local Auth users (passwords stay in .env only — never commit)
SEED_CLUB_ADMIN_LOGIN_EMAIL=""
SEED_CLUB_ADMIN_PASSWORD=""
SEED_DISTRICT_ADMIN_EMAIL=""
SEED_DISTRICT_ADMIN_NAME="District Admin"
SEED_DISTRICT_ADMIN_PASSWORD=""
SEED_DISTRICT_ADMIN_SUPABASE_ID=""
SEED_RECIPIENT_EMAIL=""
SEED_RECIPIENT_PASSWORD=""
SEED_PROMOTE_UOM_DISTRICT_ADMIN="false"

# Local only — omit both on Vercel
AUTH_DEV_BYPASS="false"
INNGEST_DEV="1"
