# Database
# On Vercel: use Supabase **transaction pooler** (port 6543) + pgbouncer=true
# Example: postgresql://postgres.PROJECT:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
# Direct (session) URL for Prisma migrate — never use pooler for migrations
DIRECT_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
# Connections per serverless isolate (1–2). Do not raise on Vercel.
PG_POOL_MAX="1"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Certificate HMAC signing (Rule 2 / §4) — never commit real values (Rule 9)
# Generate with: openssl rand -hex 32
CERT_HMAC_SECRET="replace-with-long-random-secret"
# Optional previous secret for zero-downtime rotation
CERT_HMAC_SECRET_PREVIOUS=""

# App URL (used in QR / verification links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public support contact shown in footer / privacy
NEXT_PUBLIC_SUPPORT_EMAIL="support@leoverify.org"

# Cloudflare R2 (S3-compatible) — PDF & template image storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="leoverify"
R2_PUBLIC_URL=""

# Email (Resend recommended for low volume; SES for higher volume)
RESEND_API_KEY=""
EMAIL_FROM="LeoVerify <certificates@leoverify.org>"

# Seed (prisma/seed.ts) — set SEED_ADMIN_SUPABASE_ID to the Auth user UUID
SEED_ADMIN_EMAIL="admin@uom.leoverify.local"
SEED_ADMIN_SUPABASE_ID="00000000-0000-4000-8000-000000000001"
SEED_ADMIN_NAME="UOM Club Admin"
# Optional district operator (no clubId) — or set SEED_PROMOTE_UOM_DISTRICT_ADMIN=true
# SEED_DISTRICT_ADMIN_EMAIL="district@uom.leoverify.local"
# SEED_DISTRICT_ADMIN_SUPABASE_ID="00000000-0000-4000-8000-000000000002"
# SEED_DISTRICT_ADMIN_NAME="District Admin"
# SEED_PROMOTE_UOM_DISTRICT_ADMIN="false"

# Inngest (bulk jobs)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
# Parallel PDF renders per import job (1–10)
IMPORT_ROW_CONCURRENCY="5"

# Upstash rate limit — **required on Vercel** (fail-closed if missing)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Observability (optional — leave empty to disable)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# Local only — never set true in production
AUTH_DEV_BYPASS="false"
