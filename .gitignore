# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local private certificate PDFs (never public/)
.data/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.pem
*.swp
*.swo
*~

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env*
!.env.example
.env.sentry-build-plugin

# local uploads in development
/public/uploads/*
!/public/uploads/.gitignore

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# IDE & Editors
.vscode/
.idea/
.cursor/*
!.cursor/rules/
.turbo/
tmp/
temp/

# Prisma CLI agent skill installs (local tooling noise)
.agents/
.claude/
.windsurf/
skills-lock.json

